# --- Pipeline behavior ---
HITL_ENABLED=true
CONFIDENCE_THRESHOLD=0.6
CHECKPOINT_DB_PATH=.atlaz/checkpoints.sqlite

# --- Logging (applies to the CLI, the FastAPI app, and the Celery worker) ---
LOG_LEVEL=INFO

# --- LLM provider (pluggable per LLD Section 13.1) ---
# provider: anthropic | openai | azure | custom | mock
# "custom" hits any OpenAI-compatible endpoint via LLM_BASE_URL.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=60

# --- Azure OpenAI (only used when LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Neo4j (matches docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- Qdrant vector index (LLD Section 14.3; matches docker-compose.yml's
# qdrant service) -- candidate retrieval only, never authoritative. Set
# enabled=false to make write_vector_index a no-op (e.g. no Qdrant reachable). ---
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=atlaz

# --- Capability registry (LLD Section 6.1) -- path to the YAML file
# validated against registered LangGraph nodes at graph-compile time.
# Defaults to capability_registry.yaml at the repo root. ---
CAPABILITY_REGISTRY_PATH=

# --- Celery (background ingestion jobs; matches docker-compose.yml's redis service) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- FastAPI ingestion API ---
API_HOST=0.0.0.0
API_PORT=8000
# Where the Streamlit "Start Run" page sends requests -- point this at a
# remote API host if Streamlit and the API aren't running on the same machine.
API_BASE_URL=http://localhost:8000

# --- Audit database (Postgres) ---
# ADMIN_DATABASE_URL: used ONLY by `atlaz db init` to create the `atlaz`
# database itself (CREATE DATABASE can't run inside a transaction on the
# database being created) -- points at a database that already exists
# (the server's default `postgres` database).
# DATABASE_URL: the actual `atlaz` database the app connects to afterward.
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/atlaz
DB_SCHEMA=atlaz

# --- Guideline retrieval store (used by `atlaz enhance` / the Streamlit
# "Enhance" page to RAG enterprise coding/architecture/security guidelines
# into generated modifications). Requires `pip install atlaz[guidelines]`;
# set enabled=false to skip guideline retrieval entirely. Embeddings are
# real only when LLM_PROVIDER is openai/azure with a key set -- otherwise a
# deterministic offline fallback vector is used. ---
GUIDELINE_STORE_ENABLED=true
GUIDELINE_STORE_DB_PATH=.atlaz/guidelines.db
GUIDELINE_STORE_COLLECTION=enterprise_guidelines