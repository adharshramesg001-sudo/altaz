# --- Pipeline behavior ---
HITL_ENABLED=true
CONFIDENCE_THRESHOLD=0.6
CHECKPOINT_DB_PATH=.atlaz/checkpoints.sqlite

# --- LLM provider (pluggable per LLD Section 13.1) ---
# provider: anthropic | openai | custom | mock
# "custom" hits any OpenAI-compatible endpoint via LLM_BASE_URL.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=60

# --- Neo4j (matches docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j